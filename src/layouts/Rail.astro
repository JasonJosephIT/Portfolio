---
// Art pages: Diptych's head, plus gallery.css, gallery.js and the body data Art needs.
import "@/styles/diptych.css";
import "@/styles/gallery.css";

interface Props {
  title: string;
  description: string;
  returnPage?: string;
}
const { title, description, returnPage } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#08090b">
  <link rel="preload" href="/fonts/archivo-var.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body class="gallery-page gallery-page--art art patterned" data-return-page={returnPage}>
  <a class="skip-link" href="#main">Skip to content</a>
  <slot />
  <script src="../scripts/gallery.js"></script>
</body>
</html>
