---
import "@/styles/diptych.css";
import Head from "@/layouts/Head.astro";
import CurrentField from "@/components/CurrentField.astro";

interface Props {
  title: string;
  description: string;
  bodyClass: string;
}
const { title, description, bodyClass } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<Head title={title} description={description} />
<body class={bodyClass}>
  <CurrentField />
  <slot />
</body>
</html>
