---
interface StoryProject {
  slug: string;
  name: string;
  summary: string;
  tags: string[];
}

interface Props {
  projects: StoryProject[];
}

const { projects } = Astro.props;
const chapters = projects.slice(0, 3);
---

<section class="story" aria-labelledby="story-title" data-scroll-story>
  <div class="story__sticky">
    <div class="story__copy">
      <p class="label">A working portfolio</p>
      <h2 id="story-title" class="story__title">Work becomes<br />a public signal.</h2>
      <p class="story__lede">
        Projects arrive from Open Thoughts as approved records—clear enough to browse, connected enough to ask about.
      </p>
      <div class="story__meter" aria-hidden="true"><span data-story-meter></span></div>
    </div>

    <div class="story__field" aria-hidden="true">
      <div class="story__halo story__halo--warm"></div>
      <div class="story__halo story__halo--cool"></div>
      <div class="story__plane story__plane--back"></div>
      <div class="story__plane story__plane--mid"></div>
      <div class="story__signal">
        <span class="story__signal-core"></span>
        <span class="story__signal-ring"></span>
      </div>
      <p class="story__field-note">Open Thoughts / Portfolio</p>
    </div>
  </div>

  <ol class="story__chapters">
    {chapters.map((project, index) => (
      <li class="story__chapter" data-story-chapter data-index={index}>
        <p class="story__index">{String(index + 1).padStart(2, "0")}</p>
        <h3>{project.name}</h3>
        <p>{project.summary}</p>
        <ul class="tags label" aria-label={`${project.name} tags`}>
          {project.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
        </ul>
        <a href={`/tech/${project.slug}`} class="story__link">
          See the project
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8" /></svg>
        </a>
      </li>
    ))}
  </ol>
</section>

<script>
  const stories = document.querySelectorAll<HTMLElement>("[data-scroll-story]");

  stories.forEach((story) => {
    const chapters = [...story.querySelectorAll<HTMLElement>("[data-story-chapter]")];
    const meter = story.querySelector<HTMLElement>("[data-story-meter]");

    const activate = (chapter: HTMLElement) => {
      const index = Number(chapter.dataset.index ?? 0);
      story.style.setProperty("--story-step", String(index));
      story.style.setProperty("--story-progress", `${((index + 1) / chapters.length) * 100}%`);
      chapters.forEach((item) => item.toggleAttribute("data-active", item === chapter));
      if (meter) meter.style.height = `${((index + 1) / chapters.length) * 100}%`;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) activate(visible.target as HTMLElement);
      },
      { rootMargin: "-28% 0px -42%", threshold: [0.15, 0.4, 0.7] },
    );

    chapters.forEach((chapter) => observer.observe(chapter));
    if (chapters[0]) activate(chapters[0]);
  });
</script>

<style>
  .story {
    --story-step: 0;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.92fr);
    gap: clamp(3rem, 9vw, 8rem);
    border-bottom: 1px solid var(--hairline);
  }

  .story__sticky {
    position: sticky;
    top: 72px;
    align-self: start;
    display: grid;
    height: calc(100vh - 72px);
    align-content: center;
    grid-template-columns: minmax(0, 0.8fr) minmax(13rem, 1.2fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(4rem, 10vh, 8rem);
  }

  .story__copy { align-self: center; }
  .story__title {
    max-width: 10ch;
    margin-top: 1rem;
    color: var(--ink-display);
    font-size: clamp(2.3rem, 5.4vw, 5.6rem);
    font-weight: 750;
    font-variation-settings: "wdth" 118;
    letter-spacing: -0.045em;
    line-height: 0.92;
    text-wrap: balance;
  }
  .story__lede {
    max-width: 33ch;
    margin-top: 1.5rem;
    color: var(--muted-text);
    font-size: clamp(0.95rem, 1.25vw, 1.08rem);
    line-height: 1.55;
  }
  .story__meter {
    width: 1px;
    height: 5rem;
    margin-top: 2.25rem;
    background: var(--hairline);
  }
  .story__meter span {
    display: block;
    width: 100%;
    height: 33.333%;
    background: var(--accent-tech);
    box-shadow: 0 0 16px color-mix(in srgb, var(--accent-tech) 65%, transparent);
    transition: height 700ms var(--ease-out);
  }

  .story__field {
    position: relative;
    align-self: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background:
      linear-gradient(rgba(255,255,255,.026) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.026) 1px, transparent 1px),
      #0c0d10;
    background-size: 15% 12%;
    box-shadow: 0 0 0 1px var(--bevel), 0 45px 80px -45px #000;
    perspective: 800px;
  }
  .story__field::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 48%, transparent 10%, rgba(8,9,11,.08) 42%, rgba(8,9,11,.72) 100%);
    pointer-events: none;
  }
  .story__halo {
    position: absolute;
    width: 65%;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(58px);
    opacity: .28;
    transition: transform 1s var(--ease-out), opacity 1s var(--ease-out);
  }
  .story__halo--warm { left: -34%; top: 5%; background: var(--accent-art); transform: translateY(calc(var(--story-step) * 10%)); }
  .story__halo--cool { right: -28%; bottom: 5%; background: var(--accent-tech); transform: translateY(calc(var(--story-step) * -10%)); }
  .story__plane {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 55%;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--accent-tech) 42%, transparent);
    transform-style: preserve-3d;
    transition: transform 1.1s var(--ease-out), border-color 800ms ease;
  }
  .story__plane--back { transform: translate(-50%, -50%) rotateX(62deg) rotateZ(calc(45deg + var(--story-step) * 18deg)) translateZ(-46px); }
  .story__plane--mid { transform: translate(-50%, -50%) rotateX(62deg) rotateZ(calc(45deg - var(--story-step) * 13deg)) translateZ(25px); border-color: color-mix(in srgb, var(--accent-art) 42%, transparent); }
  .story__signal {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4.4rem;
    aspect-ratio: 1;
    transform: translate(-50%, -50%) translateY(calc((var(--story-step) - 1) * 42px));
    transition: transform 1s var(--ease-out);
  }
  .story__signal-core {
    position: absolute;
    inset: 1.6rem;
    border-radius: 50%;
    background: var(--text);
    box-shadow: 0 0 28px var(--accent-tech), 0 0 55px color-mix(in srgb, var(--accent-art) 38%, transparent);
  }
  .story__signal-ring {
    position: absolute;
    inset: .35rem;
    border: 1px solid color-mix(in srgb, var(--text) 30%, transparent);
    border-radius: 50%;
  }
  .story__field-note {
    position: absolute;
    z-index: 1;
    right: 1rem;
    bottom: 1rem;
    color: var(--pencil);
    font-size: .62rem;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .story__chapters { padding-block: 32vh; }
  .story__chapter {
    display: grid;
    min-height: 72vh;
    align-content: center;
    gap: 1rem;
    color: var(--muted-text);
    opacity: .26;
    transition: opacity 550ms ease, transform 750ms var(--ease-out);
    transform: translateY(1.25rem);
  }
  .story__chapter[data-active] { opacity: 1; transform: none; }
  .story__index { color: var(--accent-tech); font-size: .75rem; letter-spacing: .14em; }
  .story__chapter h3 {
    max-width: 12ch;
    color: var(--text);
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    font-weight: 680;
    font-variation-settings: "wdth" 116;
    line-height: 1;
  }
  .story__chapter > p:not(.story__index) { max-width: 36ch; line-height: 1.55; }
  .story__link {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: .6rem;
    margin-top: .4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--accent-tech) 60%, transparent);
    padding-bottom: .35rem;
    color: var(--text);
    font-size: .82rem;
  }
  .story__link svg { width: 1rem; transition: transform 500ms var(--ease-out); }
  .story__link:hover svg, .story__link:focus-visible svg { transform: translate(3px, -3px); }

  @media (max-width: 900px) {
    .story { grid-template-columns: 1fr; gap: 0; }
    .story__sticky {
      top: 72px;
      z-index: 1;
      min-height: 68vh;
      grid-template-columns: minmax(0, .95fr) minmax(10rem, 1.05fr);
      padding-block: 3.5rem 2rem;
      background: linear-gradient(var(--background) 82%, transparent);
    }
    .story__chapters { padding-block: 8vh 20vh; }
    .story__chapter { min-height: 58vh; padding-top: 34vh; }
    .story__lede { display: none; }
  }

  @media (max-width: 560px) {
    .story__sticky { grid-template-columns: 1fr 9rem; gap: 1rem; min-height: 56vh; }
    .story__title { font-size: clamp(2rem, 10vw, 3rem); }
    .story__meter { height: 3rem; margin-top: 1.25rem; }
    .story__field-note { display: none; }
    .story__chapter { min-height: 52vh; padding-top: 30vh; }
  }

  @media (prefers-reduced-motion: reduce) {
    .story { display: block; }
    .story__sticky { position: relative; top: auto; min-height: auto; }
    .story__chapters { padding-block: 2rem; }
    .story__chapter { min-height: auto; padding-block: 3rem; opacity: 1; transform: none; }
    .story__plane, .story__halo, .story__signal, .story__meter span { transition: none; }
  }
</style>
