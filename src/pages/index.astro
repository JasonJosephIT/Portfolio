---
import { Image } from "astro:assets";
import Diptych from "@/layouts/Diptych.astro";
import bard from "@/assets/bard-mark.png";
import hero from "@/assets/hero.jpg";
---

<Diptych title="Jason — Man is not truly one, but truly two." description="Jason's portfolio home, linking to the Art and Tech sections." bodyClass="home">
  <nav class="site-nav">
    <div class="wrap">
      <a href="/" class="wordmark"><Image class="brand-mark" src={bard} alt="" width={36} height={36} />JASON</a>
      <ul class="nav-links">
        <li><a href="/" class="current">Home</a></li>
        <li><a href="/art">Art</a></li>
        <li><a href="/tech">Tech</a></li>
      </ul>
    </div>
  </nav>

  <main class="wall">
    <div class="diptych">
      <h1 class="wall-name">JASON</h1>
      <a class="panel panel-art" href="/art">
        <span class="window"><Image src={hero} alt="" width={1194} height={1600} loading="eager" fetchpriority="high" /></span>
        <span class="caption">
          <span class="label">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Art
          </span>
          <span class="plate">Panel I</span>
        </span>
      </a>

      <span class="hinge" aria-hidden="true"></span>

      <a class="panel panel-tech" href="/tech">
        <span class="window"><Image src={hero} alt="" width={1194} height={1600} loading="eager" /></span>
        <span class="caption">
          <span class="label">
            Tech
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="plate">Panel II</span>
        </span>
      </a>
    </div>
    <p class="wall-title">Man is not truly one, but truly two.</p>
  </main>

  <section class="wall-label" aria-labelledby="about-heading">
    <div class="wrap">
      <div class="wall-label-inner">
        <h2 id="about-heading">One person, two practices.</h2>
        <p>A short biography will appear here soon.</p>
        <!-- TODO: replace the placeholder address with your real contact, then remove the "address pending" note -->
        <p class="contact-line">
          <a class="contact" href="mailto:hello@example.com">
            Get in touch
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <span class="note">address pending</span>
        </p>
      </div>
    </div>
  </section>

  <footer class="frame-back">
    <div class="wrap frame-back-inner">
      <div>
        <p class="frame-name">JASON</p>
      </div>
      <nav class="frame-links" aria-label="Footer">
        <a href="/">Home</a>
        <a href="/art">Art</a>
        <a href="/tech">Tech</a>
        <!-- TODO: replace the placeholder address with your real contact, then remove the note -->
        <a href="mailto:hello@example.com">Get in touch <span class="note">address pending</span></a>
      </nav>
      <p class="frame-copy">&copy; 2026 Jason. Man is not truly one, but truly two.</p>
    </div>
  </footer>
</Diptych>
