---
import DocPage from "@/components/DocPage.astro";
import { builds, projects } from "@/lib/bundle";

export async function getStaticPaths() {
  const all = await projects();
  return (await builds()).map((doc) => {
    const project = all.find((p) => p.slug === doc.id);
    if (!project) throw new Error(`Build file ${doc.id}.md is not a bundle project (no project with slug "${doc.id}")`);
    return { params: { slug: doc.id }, props: { doc, project } };
  });
}

const { doc, project: p } = Astro.props;
---

<DocPage doc={doc} project={p} kind="How it was built" description={`How ${p.name} was built.`} />
